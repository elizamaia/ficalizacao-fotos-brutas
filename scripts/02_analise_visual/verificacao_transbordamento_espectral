# -*- coding: utf-8 -*-
"""
Plugin QGIS para Inspeção de Transbordamento Espectral em Fotografias Aéreas Brutas.

Este algoritmo realiza a varredura contígua (100% de cobertura) em blocos fixos de 
512x512 pixels para contornar o limite de memória RAM na leitura de imagens de grande formato. 
Ele identifica ocorrências onde 1 ou 2 bandas da composição RGB possuem valor nulo (0). 
Ao encontrar o primeiro erro, registra a coordenada plana do pixel e interrompe a 
leitura da foto (early stopping), gerando um relatório com as imagens reprovadas.

Autor: Agente Gerador de Plugins QGIS
Data: 2026
"""

import os
import glob
from datetime import datetime
import numpy as np
from osgeo import gdal

from qgis.core import (
    QgsProcessing,
    QgsProcessingAlgorithm,
    QgsProcessingParameterFile,
    QgsProcessingParameterFileDestination,
    QgsProcessingException
)
from qgis.PyQt.QtCore import QCoreApplication

class AnaliseTransbordamentoEspectral(QgsProcessingAlgorithm):
    """
    Algoritmo para detecção de transbordamento espectral em imagens aéreas brutas.
    Estruturado em POO, aplica leitura contígua em blocos e extrai coordenadas planas.
    """

    # =========================================================================
    # DEFINIÇÃO DE CONSTANTES DE PARÂMETROS
    # =========================================================================

    INPUT_FOLDER = 'INPUT_FOLDER'
    OUTPUT_REPORT = 'OUTPUT_REPORT'
    
    # Constante travada conforme diretriz de projeto (varredura contígua 100%)
    TAMANHO_BLOCO = 512

    # =========================================================================
    # MÉTODOS OBRIGATÓRIOS DA API QGIS
    # =========================================================================

    def tr(self, string):
        """Traduz a string usando o sistema do QGIS."""
        return QCoreApplication.translate('AnaliseTransbordamentoEspectral', string)

    def createInstance(self):
        """Cria uma nova instância do algoritmo."""
        return AnaliseTransbordamentoEspectral()

    def name(self):
        """Retorna o identificador único do algoritmo."""
        return 'inspecao_transbordamento_espectral'

    def displayName(self):
        """Retorna o nome exibido do algoritmo."""
        return self.tr('Fotos Brutas - Imagem - Transbordamento Espectral')

    def group(self):
        """Retorna o grupo do algoritmo."""
        return self.tr('Fiscalização Mapeamento SEI')

    def groupId(self):
        """Retorna o ID do grupo."""
        return 'fiscalizacao_sei'

    # =========================================================================
    # INICIALIZAÇÃO DE PARÂMETROS
    # =========================================================================

    def initAlgorithm(self, config=None):
        """Inicializa os parâmetros do algoritmo."""
        self.addParameter(
            QgsProcessingParameterFile(
                self.INPUT_FOLDER,
                self.tr('Pasta Principal com as Fotografias (TIFF/GeoTIFF)'),
                behavior=QgsProcessingParameterFile.Folder
            )
        )

        self.addParameter(
            QgsProcessingParameterFileDestination(
                self.OUTPUT_REPORT,
                self.tr('Salvar Relatório Final em (.txt)'),
                fileFilter='Arquivos de Texto (*.txt)'
            )
        )

    # =========================================================================
    # MÉTODO PRINCIPAL DE PROCESSAMENTO
    # =========================================================================

    def processAlgorithm(self, parameters, context, feedback):
        """Fluxo central de execução do algoritmo."""
        
        params = self._recuperar_parametros(parameters, context)
        lista_arquivos = self._listar_arquivos(params['pasta'], feedback)
        total_arquivos = len(lista_arquivos)

        # Buffer estruturado aos moldes do código de referência
        buffer_relatorio = []
        arquivos_reprovados = []
        erros_leitura = 0

        for i, caminho_arquivo in enumerate(lista_arquivos):
            if feedback.isCanceled():
                break

            feedback.setProgress(int((i / total_arquivos) * 100))
            nome_arquivo = os.path.basename(caminho_arquivo)

            try:
                # O processamento retorna a linha de diagnóstico caso encontre falha
                diagnostico = self._processar_arquivo(caminho_arquivo)
                
                if diagnostico:
                    arquivos_reprovados.append(diagnostico)
                    
            except IOError as e:
                erros_leitura += 1
                arquivos_reprovados.append(f"  [!] {nome_arquivo} | ERRO DE LEITURA (CORROMPIDO): {str(e)}")
                feedback.reportError(self.tr(f"Erro de I/O na imagem {nome_arquivo}: {e}"))
                
            except Exception as e:
                erros_leitura += 1
                arquivos_reprovados.append(f"  [!] {nome_arquivo} | ERRO CRÍTICO: {str(e)}")
                feedback.reportError(self.tr(f"Exceção inesperada na imagem {nome_arquivo}: {e}"))

        # Montagem unificada do relatório seguindo o padrão limpo exigido
        buffer_relatorio.extend(self._criar_cabecalho(params, total_arquivos, len(arquivos_reprovados), erros_leitura))
        
        buffer_relatorio.append("-" * 60)
        buffer_relatorio.append(self.tr("✅ VALIDAÇÃO DE TRANSBORDAMENTO ESPECTRAL"))
        buffer_relatorio.append("-" * 60)
        buffer_relatorio.append("")
        
        if arquivos_reprovados:
            buffer_relatorio.extend(arquivos_reprovados)
        else:
            buffer_relatorio.append(f"  ✓ {self.tr('Lote Aprovado - Nenhuma inconformidade espectral encontrada.')}")

        self._escrever_relatorio(params['arquivo_saida'], buffer_relatorio)
        feedback.pushInfo(self.tr(f"✓ Processamento concluído: {total_arquivos} arquivo(s)"))

        return {self.OUTPUT_REPORT: params['arquivo_saida']}

    # =========================================================================
    # MÉTODOS AUXILIARES
    # =========================================================================

    def _recuperar_parametros(self, parameters, context):
        """Organiza os parâmetros de entrada."""
        return {
            'pasta': self.parameterAsString(parameters, self.INPUT_FOLDER, context),
            'arquivo_saida': self.parameterAsString(parameters, self.OUTPUT_REPORT, context)
        }

    def _listar_arquivos(self, pasta, feedback):
        """Lista as fotos TIFF/GeoTIFF da pasta e subpastas de forma recursiva."""
        extensoes = ("*.tif", "*.tiff", "*.TIF", "*.TIFF", "*.geotiff", "*.gtif")
        arquivos = []
        for ext in extensoes:
            caminho_pesquisa = os.path.join(pasta, "**", ext)
            arquivos.extend(glob.glob(caminho_pesquisa, recursive=True))
            
        arquivos = sorted(list(set(arquivos)))
        if not arquivos:
            raise QgsProcessingException(self.tr(f"Nenhuma imagem compatível encontrada em: {pasta}"))
            
        return arquivos

    def _criar_cabecalho(self, params, total, reprovados, erros):
        """Gera o cabeçalho descritivo e estatístico do relatório."""
        aprovados = total - reprovados - erros
        linhas = [
            "=" * 80,
            self.tr("RELATÓRIO TÉCNICO: INSPEÇÃO DE TRANSBORDAMENTO ESPECTRAL"),
            self.tr(f"Data/Hora: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}"),
            "=" * 80,
            self.tr("PARÂMETROS DE CONFIGURAÇÃO:"),
            f"  • Diretório Alvo: {params['pasta']}",
            f"  • Estratégia de Varredura: Contígua 100% (Blocos fixos de {self.TAMANHO_BLOCO}px)",
            "",
            self.tr("📊 ESTATÍSTICAS GERAIS"),
            f"  • Imagens analisadas: {total}",
            f"  • Imagens aprovadas: {aprovados}",
            f"  • Imagens reprovadas: {reprovados}",
            f"  • Arquivos corrompidos: {erros}",
            ""
        ]
        return linhas

    def _processar_arquivo(self, caminho_arquivo):
        """
        Leitura da imagem em blocos com extração de coordenadas planas.
        Interrompe a verredura (early stopping) na primeira ocorrência encontrada.
        """
        nome_arquivo = os.path.basename(caminho_arquivo)
        
        # Desabilitar exceções temporariamente para gerenciar nativamente o Open
        gdal.UseExceptions()
        dataset = gdal.Open(caminho_arquivo)
        
        if dataset is None:
            raise IOError("Falha nativa do GDAL ao abrir a imagem.")

        largura = dataset.RasterXSize
        altura = dataset.RasterYSize
        num_bandas = dataset.RasterCount
        
        if num_bandas < 3:
            dataset = None
            return f"  [!] {nome_arquivo} | Motivo: Arquivo possui menos de 3 bandas espectrais."

        # Extração das informações de georreferenciamento do cabeçalho
        geotransform = dataset.GetGeoTransform()
        if geotransform is None:
            dataset = None
            return f"  [!] {nome_arquivo} | Motivo: Arquivo sem informações de georreferenciamento planas."
            
        origem_x = geotransform[0]
        res_x = geotransform[1]
        origem_y = geotransform[3]
        res_y = geotransform[5]

        # Varredura contígua (passo idêntico ao bloco assegura cobertura de 100%)
        tamanho_bloco = self.TAMANHO_BLOCO
        
        for y in range(0, altura, tamanho_bloco):
            for x in range(0, largura, tamanho_bloco):
                
                largura_janela = min(tamanho_bloco, largura - x)
                altura_janela = min(tamanho_bloco, altura - y)
                
                bloco_dados = dataset.ReadAsArray(x, y, largura_janela, altura_janela)
                
                if bloco_dados is not None and len(bloco_dados.shape) == 3:
                    # Avalia exclusivamente RGB
                    bloco_rgb = bloco_dados[:3, :, :]
                    mascara_zeros = (bloco_rgb == 0)
                    
                    # Conta a quantidade de 0 na profundidade (eixo Z das bandas)
                    contagem_zeros_pixel = np.sum(mascara_zeros, axis=0)
                    
                    # O transbordamento é caracterizado por 1 ou 2 canais nulos no pixel
                    pixels_inconformes = (contagem_zeros_pixel >= 1) & (contagem_zeros_pixel <= 2)
                    
                    if np.any(pixels_inconformes):
                        # Extrai o índice matricial local do primeiro pixel defeituoso encontrado
                        idx_y, idx_x = np.where(pixels_inconformes)
                        pos_x_global = x + idx_x[0]
                        pos_y_global = y + idx_y[0]
                        
                        # Converte a matriz para coordenada planimétrica real (Ex: UTM)
                        coord_e = origem_x + (pos_x_global * res_x)
                        coord_n = origem_y + (pos_y_global * res_y)
                        
                        dataset = None # Libera recurso
                        
                        # Retorna imediatamente a primeira coordenada, aplicando o Early Stopping
                        return f"  [!] {nome_arquivo} | Ocorrência identificada em (E: {coord_e:.2f}, N: {coord_n:.2f})"

        dataset = None 
        return None # Retorna None caso a foto seja aprovada sem erros

    def _escrever_relatorio(self, caminho_saida, buffer):
        """Escreve o relatório completo em disco."""
        try:
            with open(caminho_saida, 'w', encoding='utf-8') as f:
                f.write('\n'.join(buffer))
        except IOError as e:
            raise QgsProcessingException(self.tr(f"Erro ao escrever arquivo de saída: {str(e)}"))